# Base URL of your backend API (no trailing slash).
# If unset, the app falls back to relative "/api" (see vite.config.js dev proxy)
# and, when no backend responds, to built-in demo/mock data so the UI still works standalone.
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" to force the app to always use mock data (useful for frontend-only demos).
VITE_USE_MOCKS=false
